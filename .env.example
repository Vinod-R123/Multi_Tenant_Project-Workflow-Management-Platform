# Multi-Tenant Project Management Platform Environment Configuration

# Project Metadata
PROJECT_NAME="Multi-Tenant Project & Workflow Management Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
# Docker / Production default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multitenant_pm
# Local Windows standalone port default (if 5433 is used):
# DATABASE_URL=postgresql://postgres@localhost:5433/multitenant_pm
# SQLite fallback (optional):
# DATABASE_URL=sqlite:///./multitenant_pm.db

# Security & JWT
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]

# File Storage & Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760

# Redis / Celery (Optional Bonus)
REDIS_URL=redis://localhost:6379/0
