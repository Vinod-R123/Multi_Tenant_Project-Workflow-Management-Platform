{
  "info": {
    "name": "Multi-Tenant Project & Workflow Management API",
    "description": "Comprehensive Postman collection covering Authentication, Multi-Tenant Organizations, Projects, Tasks, Workflows, Dependencies, Comments, Files, Notifications, Dashboards, and Audit Logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "org_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"developer@acme.com\",\n  \"username\": \"developer_dan\",\n  \"password\": \"DanSecure@123\",\n  \"full_name\": \"Dan Developer\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"]}
          }
        },
        {
          "name": "Login (Acme Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.access_token) {",
                  "  pm.collectionVariables.set('token', jsonData.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', jsonData.data.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username_or_email\": \"acme_admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"]}
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"]}
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Admin@123\",\n  \"new_password\": \"NewSecretAdmin@123\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/change-password", "host": ["{{base_url}}"], "path": ["auth", "change-password"]}
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"]}
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nexus Labs\",\n  \"description\": \"Next generation research and product studio\"\n}"
            },
            "url": {"raw": "{{base_url}}/organizations", "host": ["{{base_url}}"], "path": ["organizations"]}
          }
        },
        {
          "name": "List User's Organizations",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/organizations", "host": ["{{base_url}}"], "path": ["organizations"]}
          }
        },
        {
          "name": "Get Organization Details",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/organizations/{{org_id}}", "host": ["{{base_url}}"], "path": ["organizations", "{{org_id}}"]}
          }
        },
        {
          "name": "Add Member to Organization",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"developer_dan\",\n  \"role\": \"TEAM_MEMBER\"\n}"
            },
            "url": {"raw": "{{base_url}}/organizations/{{org_id}}/members", "host": ["{{base_url}}"], "path": ["organizations", "{{org_id}}", "members"]}
          }
        },
        {
          "name": "Update Member Role",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"PROJECT_MANAGER\"\n}"
            },
            "url": {"raw": "{{base_url}}/organizations/{{org_id}}/members/3/role", "host": ["{{base_url}}"], "path": ["organizations", "{{org_id}}", "members", "3", "role"]}
          }
        },
        {
          "name": "List Organization Members",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/organizations/{{org_id}}/members?page=1&page_size=20", "host": ["{{base_url}}"], "path": ["organizations", "{{org_id}}", "members"], "query": [{"key": "page", "value": "1"}, {"key": "page_size", "value": "20"}]}
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile App Redesign\",\n  \"description\": \"Complete overhaul of iOS and Android applications\",\n  \"status\": \"PLANNING\"\n}"
            },
            "url": {"raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"]}
          }
        },
        {
          "name": "List Projects (Filters & Pagination)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "url": {"raw": "{{base_url}}/projects?page=1&page_size=10&status=ACTIVE", "host": ["{{base_url}}"], "path": ["projects"], "query": [{"key": "page", "value": "1"}, {"key": "page_size", "value": "10"}, {"key": "status", "value": "ACTIVE"}]}
          }
        },
        {
          "name": "Get Project by ID",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "url": {"raw": "{{base_url}}/projects/1", "host": ["{{base_url}}"], "path": ["projects", "1"]}
          }
        },
        {
          "name": "Update Project Status (Workflow Transition)",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {"raw": "{{base_url}}/projects/1", "host": ["{{base_url}}"], "path": ["projects", "1"]}
          }
        },
        {
          "name": "Add Member to Project",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 4\n}"
            },
            "url": {"raw": "{{base_url}}/projects/1/members", "host": ["{{base_url}}"], "path": ["projects", "1", "members"]}
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": 1,\n  \"title\": \"Implement Payment Gateway Integration\",\n  \"description\": \"Integrate Stripe Elements and Webhook listener\",\n  \"priority\": \"HIGH\",\n  \"assignee_id\": 4,\n  \"estimated_hours\": 16\n}"
            },
            "url": {"raw": "{{base_url}}/tasks", "host": ["{{base_url}}"], "path": ["tasks"]}
          }
        },
        {
          "name": "List Tasks (Search, Filter, Sort, Paginate)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "url": {"raw": "{{base_url}}/tasks?page=1&page_size=20&status=TODO&priority=HIGH&search=Payment", "host": ["{{base_url}}"], "path": ["tasks"], "query": [{"key": "page", "value": "1"}, {"key": "page_size", "value": "20"}, {"key": "status", "value": "TODO"}, {"key": "priority", "value": "HIGH"}, {"key": "search", "value": "Payment"}]}
          }
        },
        {
          "name": "Change Task Status (Workflow Transition)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": {"raw": "{{base_url}}/tasks/1/status", "host": ["{{base_url}}"], "path": ["tasks", "1", "status"]}
          }
        },
        {
          "name": "Assign Task",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee_id\": 4\n}"
            },
            "url": {"raw": "{{base_url}}/tasks/1/assign", "host": ["{{base_url}}"], "path": ["tasks", "1", "assign"]}
          }
        },
        {
          "name": "Add Task Dependency",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depends_on_task_id\": 2\n}"
            },
            "url": {"raw": "{{base_url}}/tasks/3/dependencies", "host": ["{{base_url}}"], "path": ["tasks", "3", "dependencies"]}
          }
        }
      ]
    },
    {
      "name": "Comments & Mentions",
      "item": [
        {
          "name": "Add Comment with Mention",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": 1,\n  \"content\": \"Great progress @alice! Please verify the unit tests for webhook error handling.\"\n}"
            },
            "url": {"raw": "{{base_url}}/comments", "host": ["{{base_url}}"], "path": ["comments"]}
          }
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "url": {"raw": "{{base_url}}/comments?task_id=1", "host": ["{{base_url}}"], "path": ["comments"], "query": [{"key": "task_id", "value": "1"}]}
          }
        }
      ]
    },
    {
      "name": "Files & Attachments",
      "item": [
        {
          "name": "Upload Attachment",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "task_id", "value": "1", "type": "text"},
                {"key": "file", "type": "file", "src": ""}
              ]
            },
            "url": {"raw": "{{base_url}}/files/upload", "host": ["{{base_url}}"], "path": ["files", "upload"]}
          }
        },
        {
          "name": "Download File",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "url": {"raw": "{{base_url}}/files/1/download", "host": ["{{base_url}}"], "path": ["files", "1", "download"]}
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "url": {"raw": "{{base_url}}/notifications?page=1&page_size=20", "host": ["{{base_url}}"], "path": ["notifications"]}
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "url": {"raw": "{{base_url}}/notifications/read-all", "host": ["{{base_url}}"], "path": ["notifications", "read-all"]}
          }
        }
      ]
    },
    {
      "name": "Dashboard & Audit",
      "item": [
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "url": {"raw": "{{base_url}}/dashboard/stats", "host": ["{{base_url}}"], "path": ["dashboard", "stats"]}
          }
        },
        {
          "name": "List Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "X-Organization-ID", "value": "{{org_id}}"}
            ],
            "url": {"raw": "{{base_url}}/audit-logs?page=1&page_size=20", "host": ["{{base_url}}"], "path": ["audit-logs"]}
          }
        }
      ]
    }
  ]
}
